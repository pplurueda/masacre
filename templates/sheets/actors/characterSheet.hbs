<form class="{{cssClass}}" autocomplete="off">
    <header>
        <div class="characterHeader">
            <!-- Character Portrait -->
            <div class="characterPortrait">
                <img src="{{actor.img}}" data-edit="img" title={{actor.name}} height="100px"/>
            </div>
            
            <div>{{localize "masacre.general.name"}}</div>
            <div class="fieldName">
                <h1 class="charname"><input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'masacre.name'}}"/></h1>
            </div>
        </div>
    </header>

    <div>{{localize "masacre.character.reputation"}}</div>
    <input name="system.reputation" type="text" value="{{actor.system.reputation}}" placeholder="{{localize 'masacre.character.reputation'}}"/>

    <li data-item-id="{{actor.system.rank.id}}">
        <div>{{localize "masacre.character.rank"}}</div>
        <div>{{concat actor.system.rank.name "[" actor.system.rank.system.value "]"}}</div>
        <div class="itemControls">
            <a class="itemControl" data-action="edit" title="{{'masacre.edit'}}">
                <i class="fas fa-edit"></i>
            </a>
            <a class="itemControl" data-action="delete" title="{{'masacre.delete'}}">
                <i class="fas fa-trash"></i>
            </a>
        </div>
    </li>

    <h1>{{localize "masacre.character.deathAliens"}}</h1>
    <div>{{localize "masacre.character.deathAliensCurrent"}}</div>
    <input name="system.deathAliens.current" type="number" value="{{actor.system.deathAliens.current}}"/>
    <div>{{localize "masacre.character.deathAliensTotal"}}</div>
    <input name="system.deathAliens.total" type="number" value="{{actor.system.deathAliens.total}}"/>

    <h1>{{localize "masacre.character.wounds"}}</h1>
    <div>{{localize "masacre.character.woundsMadeMess"}}</div>
    <input name="system.wounds.madeMess" type="checkbox" {{#if actor.system.wounds.madeMess}}checked{{/if}}/>
    <div>{{localize "masacre.character.woundsCrippled"}}</div>
    <input name="system.wounds.crippled" type="checkbox" {{#if actor.system.wounds.crippled}}checked{{/if}}/>
    <div>{{localize "masacre.character.woundsDeath"}}</div>
    <input name="system.wounds.death" type="checkbox" {{#if actor.system.wounds.death}}checked{{/if}}/>

    <h1>{{localize "masacre.character.oncePerPlanet"}}</h1>
    <div>{{localize "masacre.character.mandelBriteArmor"}}</div>
    <input name="system.mandelBriteArmorUsed" type="checkbox" {{#if actor.system.mandelBriteArmorUsed}}checked{{/if}}/>
    <div>{{localize "masacre.character.combatDrugs"}}</div>
    <input name="system.combatDrugUsed" type="checkbox" {{#if actor.system.combatDrugUsed}}checked{{/if}}/>

    <h1>{{localize "masacre.character.combatSkillAcronym"}}</h1>
    <div>{{localize "masacre.character.combatSkill"}}</div>
    <input name="system.combatSkill" type="number" value="{{actor.system.combatSkill}}"/>

    <h1>{{localize "masacre.character.nonCombatSkillAcronym"}}</h1>
    <div>{{localize "masacre.character.nonCombatSkill"}}</div>
    <input name="system.nonCombatSkill" type="number" value="{{actor.system.nonCombatSkill}}"/>

    {{> "systems/masacre/templates/partials/weaponListPartial.hbs"}}
</form>