<form class="{{cssClass}}">
    <header class="sheet-header">
        <img class="actor-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
        <h1>{{toUpperCase (localize "masacre.general.threeSixteen")}}</h1>
        <h2 class="flashbacks-title">{{toUpperCase (localize "masacre.character.flashback")}}</h2>
    </header>

    <main class="main-content">
        <!-- Columna Izquierda -->
        <div class="column left-column">
            <section class="character-info">
                <div class="field">
                    <label for="nombre">{{localize "masacre.general.name"}}</label>
                    <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'masacre.general.name'}}"/>
                </div>
                <div class="field">
                    <label for="reputacion">{{localize "masacre.character.reputation"}}</label>
                    <input name="system.reputation" type="text" value="{{actor.system.reputation}}" placeholder="{{localize 'masacre.character.reputation'}}"/>
                </div>
                <div class="field">
                    <label for="rango">{{localize "masacre.character.rank"}}</label>
                    <li class="rank-item" data-item-id="{{actor.system.rank.id}}">
                        <div class="rank-description">{{concat actor.system.rank.name "[" actor.system.rank.system.value "]"}}</div>
                        <div class="itemControls">
                            <a class="itemControl" data-action="edit" title="{{'masacre.edit'}}">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a class="itemControl" data-action="delete" title="{{'masacre.delete'}}">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </li>
                </div>
            </section>

            {{> "systems/masacre/templates/partials/character-creatures-killed.hbs"}}

            {{> "systems/masacre/templates/partials/character-health.hbs"}}
            
            {{> "systems/masacre/templates/partials/character-once-per-planet.hbs"}}

            {{> "systems/masacre/templates/partials/character-weapons.hbs"}}
        </div>

        <!-- Columna Central -->
        <div class="column center-column">
            {{> "systems/masacre/templates/partials/character-stats.hbs"}}
        </div>

        {{!-- Columna Derecha --}}
        <div class="column right-column">
            {{> "systems/masacre/templates/partials/character-qualities.hbs"}}

            {{> "systems/masacre/templates/partials/character-flaws.hbs"}}

            {{> "systems/masacre/templates/partials/character-rank-details.hbs"}}

            <section class="medals">
                <h3 class="section-title-right">{{toUpperCase (localize "masacre.character.medals")}}</h3>
            </section>

            <section class="notes">
                <h3 class="section-title-right">{{toUpperCase (localize "masacre.character.notes")}}</h3>
            </section>
        </div>
    </main>
</form>

{{!-- </body>
</html> --}}