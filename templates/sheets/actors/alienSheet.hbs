<form class="{{cssClass}}" autocomplete="off">
    <header class="sheet-header">
        <img class="actor-portrait" src="{{actor.img}}" data-edit="img" title="{{actor.name}}"/>
        <input class="header-name" name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'masacre.general.name'}}"/>
    </header>

    <main class="main-content">
        <!-- Columna Izquierda -->
        <div class="column left-column">
            {{> "systems/masacre/templates/partials/alien-stats-section.hbs"}}
            {{> "systems/masacre/templates/partials/alien-hp-section.hbs"}}
            {{> "systems/masacre/templates/partials/alien-hazard-sheets-section.hbs"}}
        </div>

        <!-- Columna Derecha -->
        <div class="column right-column">
            {{> "systems/masacre/templates/partials/alien-description-section.hbs"}}
            {{> "systems/masacre/templates/partials/alien-abilities-section.hbs"}}
        </div>
    </main>
</form>
