<form class="{{cssClass}}">
    <header class="sheet-header">
        <img class="item-portrait" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
        <h1>{{toUpperCase (localize "masacre.rank.title")}}</h1>
    </header>

    <main class="rank-content">
        <section class="rank-info">
            <div class="field">
                <label>{{localize "masacre.general.name"}}</label>
                <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'masacre.general.name'}}"/>
            </div>
        </section>

        <section class="rank-value">
            <div class="stat-box">
                <div class="stat-label">
                    <span class="stat-abbr">{{localize "masacre.rank.valueAbbr"}}</span>
                    <span class="stat-desc">{{localize "masacre.rank.value"}}</span>
                </div>
                <div class="stat-square">
                    <input name="system.value" type="number" value="{{item.system.value}}" min="1"/>
                </div>
            </div>
        </section>

        <section class="rank-details">
            <h3 class="section-title">{{toUpperCase (localize "masacre.rank.details")}}</h3>
            
            <div class="field">
                <label>{{localize "masacre.rank.description"}}</label>
                <input name="system.description" type="text" value="{{item.system.description}}" placeholder="{{localize 'masacre.rank.descriptionPlaceholder'}}"/>
            </div>

            <div class="field">
                <label>{{localize "masacre.rank.quote"}}</label>
                <input name="system.quote" type="text" value="{{item.system.quote}}" placeholder="{{localize 'masacre.rank.quotePlaceholder'}}"/>
            </div>

            <div class="field">
                <label>{{localize "masacre.rank.equipment"}}</label>
                <input name="system.equipment" type="text" value="{{item.system.equipment}}" placeholder="{{localize 'masacre.rank.equipmentPlaceholder'}}"/>
            </div>

            <div class="field">
                <label>{{localize "masacre.rank.responsibility"}}</label>
                {{editor item.system.responsibility target="system.responsibility" button=true owner=owner editable=editable}}
                <!-- <input name="system.responsibility" type="text" value="{{item.system.responsibility}}" placeholder="{{localize 'masacre.rank.responsibilityPlaceholder'}}"/> -->
            </div>
        </section>
    </main>
</form>
