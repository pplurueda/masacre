<form class="{{cssClass}}">
    <header class="sheet-header">
        <img class="item-portrait" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
        <input class="header-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'masacre.general.name'}}"/>
    </header>

    <main class="rank-content">
        <section class="rank-value">
            <div class="stat-box">
                <div class="stat-label">
                    <span class="stat-abbr">{{localize "masacre.rank.valueAbbr"}}</span>
                    <span class="stat-desc">{{localize "masacre.rank.value"}}</span>
                </div>
                <div class="stat-square">
                    <input name="system.value" type="number" value="{{item.system.value}}" min="1"/>
                </div>
            </div>
        </section>

        <section class="rank-details">
            <h3 class="section-title">{{toUpperCase (localize "masacre.rank.details")}}</h3>
            
            <div class="field">
                <label>{{localize "masacre.rank.description"}}</label>
                <div class="editor-container">
                    {{editor system.description target="system.description" button=true owner=owner editable=editable}}
                </div>
            </div>

            <div class="field">
                <label>{{localize "masacre.rank.quote"}}</label>
                <div class="editor-container">
                    {{editor system.quote target="system.quote" button=true owner=owner editable=editable}}
                </div>
            </div>

            <div class="field">
                <label>{{localize "masacre.rank.equipment"}}</label>
                <div class="editor-container">
                    {{editor system.equipment target="system.equipment" button=true owner=owner editable=editable}}
                </div>
            </div>            

            <div class="field">
                <label>{{localize "masacre.rank.responsibility"}}</label>
                <div class="editor-container">
                    {{editor system.responsibility target="system.responsibility" button=true owner=owner editable=editable}}
                </div>
            </div>

            <div class="field">
                <label>{{localize "masacre.rank.resources"}}</label>
                <div class="editor-container">
                    {{editor system.resources target="system.resources" button=true owner=owner editable=editable}}
                </div>
            </div>
        </section>
    </main>
</form>
