<form class="{{cssClass}}">
    <header class="sheet-header">
        <img class="item-portrait" src="{{item.img}}" data-edit="img" title="{{item.name}}"/>
        <h1>{{toUpperCase (localize "masacre.weapon.title")}}</h1>
    </header>

    <main class="weapon-content">
        <section class="weapon-info">
            <div class="field">
                <label>{{localize "masacre.general.name"}}</label>
                <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'masacre.general.name'}}"/>
            </div>
        </section>

        <section class="weapon-stats">
            <h3 class="section-title">{{toUpperCase (localize "masacre.weapon.stats")}}</h3>
            <div class="stats-grid">
                <div class="stat-box">
                    <div class="stat-label">
                        <span class="stat-abbr">{{localize "masacre.weapon.cc"}}</span>
                        <span class="stat-desc">{{localize "masacre.weapon.ccFull"}}</span>
                    </div>
                    <div class="stat-square">
                        <div class="stat-value-selector">
                            <a class="stat-arrow stat-arrow-up" data-action="cycle-stat" data-stat="cc" data-direction="up">
                                <i class="fas fa-chevron-up"></i>
                            </a>
                            <input name="system.cc" type="text" value="{{item.system.cc}}" readonly/>
                            <a class="stat-arrow stat-arrow-down" data-action="cycle-stat" data-stat="cc" data-direction="down">
                                <i class="fas fa-chevron-down"></i>
                            </a>
                        </div>
                    </div>
                    <div class="stat-square">
                        <div class="stat-value-selector">
                            <a class="stat-arrow stat-arrow-up" data-action="cycle-stat" data-stat="ccmax" data-direction="up">
                                <i class="fas fa-chevron-up"></i>
                            </a>
                            <input name="system.ccmax" type="text" value="{{item.system.ccmax}}" readonly/>
                            <a class="stat-arrow stat-arrow-down" data-action="cycle-stat" data-stat="ccmax" data-direction="down">
                                <i class="fas fa-chevron-down"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">
                        <span class="stat-abbr">{{localize "masacre.weapon.cd"}}</span>
                        <span class="stat-desc">{{localize "masacre.weapon.cdFull"}}</span>
                    </div>
                    <div class="stat-square">
                        <div class="stat-value-selector">
                            <a class="stat-arrow stat-arrow-up" data-action="cycle-stat" data-stat="cd" data-direction="up">
                                <i class="fas fa-chevron-up"></i>
                            </a>
                            <input name="system.cd" type="text" value="{{item.system.cd}}" readonly/>
                            <a class="stat-arrow stat-arrow-down" data-action="cycle-stat" data-stat="cd" data-direction="down">
                                <i class="fas fa-chevron-down"></i>
                            </a>
                        </div>
                    </div>
                    <div class="stat-square">
                        <div class="stat-value-selector">
                            <a class="stat-arrow stat-arrow-up" data-action="cycle-stat" data-stat="cdmax" data-direction="up">
                                <i class="fas fa-chevron-up"></i>
                            </a>
                            <input name="system.cdmax" type="text" value="{{item.system.cdmax}}" readonly/>
                            <a class="stat-arrow stat-arrow-down" data-action="cycle-stat" data-stat="cdmax" data-direction="down">
                                <i class="fas fa-chevron-down"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="stat-box">
                    <div class="stat-label">
                        <span class="stat-abbr">{{localize "masacre.weapon.ld"}}</span>
                        <span class="stat-desc">{{localize "masacre.weapon.ldFull"}}</span>
                    </div>
                    <div class="stat-square">
                        <div class="stat-value-selector">
                            <a class="stat-arrow stat-arrow-up" data-action="cycle-stat" data-stat="ld" data-direction="up">
                                <i class="fas fa-chevron-up"></i>
                            </a>
                            <input name="system.ld" type="text" value="{{item.system.ld}}" readonly/>
                            <a class="stat-arrow stat-arrow-down" data-action="cycle-stat" data-stat="ld" data-direction="down">
                                <i class="fas fa-chevron-down"></i>
                            </a>
                        </div>
                    </div>
                    <div class="stat-square">
                        <div class="stat-value-selector">
                            <a class="stat-arrow stat-arrow-up" data-action="cycle-stat" data-stat="ldmax" data-direction="up">
                                <i class="fas fa-chevron-up"></i>
                            </a>
                            <input name="system.ldmax" type="text" value="{{item.system.ldmax}}" readonly/>
                            <a class="stat-arrow stat-arrow-down" data-action="cycle-stat" data-stat="ldmax" data-direction="down">
                                <i class="fas fa-chevron-down"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="weapon-description">
            <h3 class="section-title">{{toUpperCase (localize "masacre.weapon.description")}}</h3>
            <div class="editor-container">
                {{editor item.system.description target="system.description" button=true owner=owner editable=editable}}
            </div>
        </section>
    </main>
</form>
