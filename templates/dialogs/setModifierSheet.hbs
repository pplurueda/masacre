<div class="masacre roll-hability-result">
    <div class="roll-details">
        <div class="roll-detail-row">
            <span class="detail-label">{{localize "masacre.roll.habilityName"}}:</span>
            <span class="detail-value">{{description}}</span>
        </div>
        <div class="roll-detail-row">
            <span class="detail-label">{{localize "masacre.roll.value"}}:</span>
            <span class="detail-value">{{value}}</span>
        </div>
    </div>

    <div class="modifier-buttons">
        <button type="button" class="modifier-btn" data-modifier="-2">-2</button>
        <button type="button" class="modifier-btn" data-modifier="-1">-1</button>
        <button type="button" class="modifier-btn modifier-btn-roll" data-modifier="0">{{localize "masacre.dialog.roll"}}</button>
        <button type="button" class="modifier-btn" data-modifier="1">+1</button>
        <button type="button" class="modifier-btn" data-modifier="2">+2</button>
    </div>
</div>
