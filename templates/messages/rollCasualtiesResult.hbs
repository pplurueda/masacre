<div class="masacre roll-casualties-result">
    <div class="roll-header">
        <img class="actor-portrait" src="{{actorImagen}}" alt="Actor"/>
        <h2 class="roll-title">{{localize "masacre.roll.casualties"}}</h2>
        <img class="weapon-icon" src="{{weaponImage}}" alt="Weapon"/>
    </div>
    
    <div class="roll-details">
        <div class="roll-detail-row">
            <span class="detail-label">{{localize "masacre.roll.weapon"}}:</span>
            <span class="detail-value">{{weapon}}</span>
        </div>
        
        <div class="roll-detail-row">
            <span class="detail-label">{{localize "masacre.roll.range"}}:</span>
            <span class="detail-value">{{stat}}</span>
        </div>
        
        <div class="roll-detail-row">
            <span class="detail-label">{{localize "masacre.roll.formula"}}:</span>
            <span class="detail-value">{{value}}</span>
        </div>
    </div>
    
    <div class="roll-result">
        <span class="result-label">{{localize "masacre.roll.result"}}:</span>
        <span class="result-value">{{result}}</span>
    </div>
</div>
