<div class="masacre item-info medal-info">
    <div class="item-info-header">
        <img class="item-portrait" src="{{item.img}}" alt="{{item.name}}"/>
        <h2 class="item-title">{{item.name}}</h2>
    </div>
    
    <div class="item-info-details">
        <div class="item-info-row">
            <span class="detail-label">{{localize "masacre.medal.bars"}}:</span>
            <span class="detail-value">
                {{#times item.system.bars}}
                <i class="fas fa-shield"></i>
                {{/times}}
            </span>
        </div>
        {{#if item.system.description}}
        <div class="item-info-description">
            <span class="detail-label">{{localize "masacre.medal.description"}}:</span>
            <div class="description-content">{{{item.system.description}}}</div>
        </div>
        {{/if}}
    </div>
</div>
