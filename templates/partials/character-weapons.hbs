<section class="weapons">
    <h3 class="section-title">{{toUpperCase (localize "masacre.character.weapons")}}</h3>
    <div class="weapon-list">
        <div class="weapon-header">
            <span class="weapon-col weapon-col-desc">{{localize "masacre.weapon.description"}}</span>
            <span class="weapon-col weapon-col-stat">{{localize "masacre.weapon.cc"}}</span>
            <span class="weapon-col weapon-col-stat">{{localize "masacre.weapon.cd"}}</span>
            <span class="weapon-col weapon-col-stat">{{localize "masacre.weapon.ld"}}</span>
            <span class="weapon-col weapon-col-controls"></span>
        </div>
        {{#each actor.system.weapons as |weapon|}}
        <li class="weapon-row" data-item-id="{{weapon._id}}">
            <span class="weapon-col weapon-col-desc">{{weapon.name}}</span>
            <span class="weapon-col weapon-col-stat rollable" data-type="bajas" data-image="{{weapon.img}}" data-stat={{localize "masacre.weapon.cc"}} data-weapon="{{weapon.name}}" data-value="{{weapon.system.cc}}">{{weapon.system.cc}}</span>
            <span class="weapon-col weapon-col-stat rollable" data-type="bajas" data-image="{{weapon.img}}" data-stat={{localize "masacre.weapon.cd"}} data-weapon="{{weapon.name}}" data-value="{{weapon.system.cd}}">{{weapon.system.cd}}</span>
            <span class="weapon-col weapon-col-stat rollable" data-type="bajas" data-image="{{weapon.img}}" data-stat={{localize "masacre.weapon.ld"}} data-weapon="{{weapon.name}}" data-value="{{weapon.system.ld}}">{{weapon.system.ld}}</span>
            <span class="weapon-col weapon-col-controls">
                <a class="itemControl" data-action="edit" title="{{localize 'masacre.general.edit'}}">
                    <i class="fas fa-edit"></i>
                </a>
                <a class="itemControl" data-action="delete" title="{{localize 'masacre.general.delete'}}">
                    <i class="fas fa-trash"></i>
                </a>
            </span>
        </li>
        {{/each}}
    </div>
</section>
