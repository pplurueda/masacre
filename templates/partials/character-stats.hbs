<div class="stat-box">
    <div class="stat-label">
        <span class="stat-abbr rollable"  data-type="hability" data-stat="combatSkill" data-description={{localize "masacre.character.combatSkillAcronym"}} data-value="{{actor.system.combatSkill}}">{{localize "masacre.character.combatSkillAcronym"}}</span>
        <span class="stat-desc">{{toUpperCase (localize "masacre.character.combatSkill")}}</span>
    </div>
    <div class="stat-main-row">
        <div class="stat-square">
            <input name="system.combatSkill" type="number" value="{{actor.system.combatSkill}}" min="0"/>
        </div>
        <div class="stat-actions">
            <img class="stat-action-icon rollable" data-type="hability" data-stat="combatSkill" data-description={{localize "masacre.character.combatSkillAcronym"}} data-value="{{actor.system.combatSkill}}" src="systems/masacre/assets/img/Dado.png" alt="Roll" title="{{localize 'masacre.roll.hability'}}" />
            <img class="stat-action-icon rollable" data-type="initiative" data-stat="combatSkill" data-description={{localize "masacre.character.combatSkillAcronym"}} data-value="{{actor.system.combatSkill}}" src="systems/masacre/assets/img/Initiative.png" alt="Initiative" title="{{localize 'masacre.character.initiative'}}" />
        </div>
    </div>
</div>
<div class="stat-box">
    <div class="stat-label">
        <span class="stat-abbr rollable" data-type="hability" data-stat="nonCombatSkill" data-description={{localize "masacre.character.nonCombatSkillAcronym"}} data-value="{{actor.system.nonCombatSkill}}">{{localize "masacre.character.nonCombatSkillAcronym"}}</span>
        <span class="stat-desc">{{toUpperCase (localize "masacre.character.nonCombatSkill")}}</span>
    </div>
    <div class="stat-main-row">
        <div class="stat-square">
            <input name="system.nonCombatSkill" type="number" value="{{actor.system.nonCombatSkill}}" min="0"/>
        </div>
        <div class="stat-actions">
            <img class="stat-action-icon rollable" data-type="hability" data-stat="nonCombatSkill" data-description={{localize "masacre.character.nonCombatSkillAcronym"}} data-value="{{actor.system.nonCombatSkill}}" src="systems/masacre/assets/img/Dado.png" alt="Roll" title="{{localize 'masacre.roll.hability'}}" />
            <img class="stat-action-icon rollabel" data-type="initiative" data-stat="nonCombatSkill" data-description={{localize "masacre.character.nonCombatSkillAcronym"}} data-value="{{actor.system.nonCombatSkill}}" src="systems/masacre/assets/img/Initiative.png" alt="Initiative" title="{{localize 'masacre.character.initiative'}}" />
        </div>
    </div>
</div>
