<section class="health">
    <h3 class="section-title">{{toUpperCase (localize "masacre.character.wounds")}}</h3>
    <div class="health-statuses">
        <div class="health-item">
            <label>{{toUpperCase (localize "masacre.character.woundsMadeMess")}}</label>
            <label class="skull-toggle">
                <input name="system.wounds.madeMess" type="checkbox" {{#if actor.system.wounds.madeMess}}checked{{/if}}/>
                <i class="fa-regular fa-skull skull-off"></i>
                <i class="fa-solid fa-skull skull-on"></i>
            </label>
        </div>
        <div class="health-item">
            <label>{{toUpperCase (localize "masacre.character.woundsCrippled")}}</label>
            <label class="skull-toggle">
                <input name="system.wounds.crippled" type="checkbox" {{#if actor.system.wounds.crippled}}checked{{/if}}/>
                <i class="fa-regular fa-skull skull-off"></i>
                <i class="fa-solid fa-skull skull-on"></i>
            </label>
        </div>
        <div class="health-item">
            <label>{{toUpperCase (localize "masacre.character.woundsDeath")}}</label>
            <label class="skull-toggle">
                <input name="system.wounds.death" type="checkbox" {{#if actor.system.wounds.death}}checked{{/if}}/>
                <i class="fa-regular fa-skull skull-off"></i>
                <i class="fa-solid fa-skull skull-on"></i>
            </label>
        </div>
    </div>
</section>
