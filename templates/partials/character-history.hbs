<section class="character-history">
    <h3 class="section-title">{{toUpperCase (localize "masacre.character.history")}}</h3>
    <div class="field">
        <label for="survivedMissions">{{localize "masacre.character.historySurvivedMissions"}}</label>
        <input name="system.history.survivedMissions" type="number" value="{{actor.system.history.survivedMissions}}"/>
    </div>
    <div class="field">
        <label for="injuriesSuffered">{{localize "masacre.character.historyInjuriesSuffered"}}</label>
        <input name="system.history.injuriesSuffered" type="number" value="{{actor.system.history.injuriesSuffered}}"/>
    </div>
</section>
