<section class="once-per-planet">
    <h3 class="section-title">{{toUpperCase (localize "masacre.character.oncePerPlanet")}}</h3>
    <div class="items">
        <div class="item">
            <label>{{toUpperCase (localize "masacre.character.mandelBriteArmor")}}</label>
            <label class="skull-toggle skull-toggle-lg">
                <input name="system.mandelBriteArmorUsed" type="checkbox" {{#if actor.system.mandelBriteArmorUsed}}checked{{/if}}/>
                <i class="fa-regular fa-skull skull-off"></i>
                <i class="fa-solid fa-skull skull-on"></i>
            </label>
        </div>
        <div class="item">
            <label>{{toUpperCase (localize "masacre.character.combatDrugs")}}</label>
            <label class="skull-toggle skull-toggle-lg">
                <input name="system.combatDrugUsed" type="checkbox" {{#if actor.system.combatDrugUsed}}checked{{/if}}/>
                <i class="fa-regular fa-skull skull-off"></i>
                <i class="fa-solid fa-skull skull-on"></i>
            </label>
        </div>
    </div>
</section>
