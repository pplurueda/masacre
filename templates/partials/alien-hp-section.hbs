<section class="hp-section">
    <div class="hp-display">
        <div class="hp-field">
            <label>{{localize "masacre.general.current"}}</label>
            <input name="system.hp.value" type="number" value="{{actor.system.hp.value}}" min="0"/>
        </div>
        <div class="hp-separator">/</div>
        <div class="hp-field">
            <label>{{localize "masacre.general.max"}}</label>
            <input name="system.hp.max" type="number" value="{{actor.system.hp.max}}" min="0"/>
        </div>
    </div>
</section>
